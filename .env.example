# ─── Database ──────────────────────────────────────────────
DB_PASSWORD=your_secure_password_here

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-minimum-32-characters-long

# ─── MSG91 (SMS OTP) ──────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=TCHTRN
MSG91_TEMPLATE_ID=

# ─── Razorpay (Payments) ──────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email ─────────────────────────────────────────────────
# Set to "log" to print emails to console (great for local dev)
# Set to "smtp" to send real emails
EMAIL_PROVIDER=log

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@teachertransfer.in
EMAIL_FROM_NAME=TeacherTransfer

# ─── App ───────────────────────────────────────────────────
APP_NAME=TeacherTransfer
APP_DOMAIN=localhost
